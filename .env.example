# --- Telegram (required) ---
# From @BotFather: /newbot -> token like 123456:ABC-DEF...
BOT_TOKEN=
# Optional: your bot's username without @
BOT_USERNAME=

# --- Owner (required) ---
# Your numeric telegram id (ask @userinfobot). Sees every tenant.
OWNER_TG_ID=

# --- Storage ---
# On Railway: attach a Volume mounted at /data
DATA_DIR=/data

# --- Optional tuning ---
PORT=8080
DEFAULT_AGENT_CAPACITY=10
SLA_TICK_SECONDS=60
BACKUP_KEEP=7
# DEV=1 boots without a token (offline self-test only)
# DEV=0
